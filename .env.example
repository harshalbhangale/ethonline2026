# Public browser configuration
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only authentication secret — never add NEXT_PUBLIC_ to this name
PRIVY_APP_SECRET=

# Supabase Postgres runtime URL (transaction pooler is supported)
DATABASE_URL=

# Optional direct/session connection for Prisma migrations
DIRECT_URL=

# Public Mapbox token for the campaign location globe and city map.
# Mapbox GL JS runs in the browser, so this must be a public `pk.` token and
# must be URL-restricted to your domains. Never use a secret `sk.` token here.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Reserved for Phase 2 Supabase Storage and Realtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development-only demo controls on the campaign page. Keep false in production.
NEXT_PUBLIC_DEMO_MODE=false

# --- Onchain (Sepolia) -------------------------------------------------------
# Escrow operator key: deploys contracts, registers placements, tops up gas.
# Server-only. Use a testnet-only key.
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CHAIN_ID=11155111
# Deployed addresses: see contracts/deployments/sepolia.json
NEXT_PUBLIC_USDC_ADDRESS=0xa76BAd9b75814553A75BD3Db189C47fb9030549A
NEXT_PUBLIC_ESCROW_ADDRESS=0xF422ddFE8153d625B0724d5116eb73C75EF918d0
# Set to false when NEXT_PUBLIC_USDC_ADDRESS is a real token such as Circle USDC.
NEXT_PUBLIC_USDC_MINTABLE=true
# Chainlink CRE simulation forwarder on Sepolia (trusted by the escrow).
CRE_FORWARDER_ADDRESS=0x15fC6ae953E024d975e77382eEeC56A9101f9F88
# Path to the CRE CLI binary (defaults to ~/.local/bin/cre).
CRE_CLI_PATH=

# --- Chainlink CRE secrets -----------------------------------------------------
# Released by the Vault DON into the enclave; the app checks the API key on
# /api/cre. Generate each with: openssl rand -hex 24
STICKERBOMB_EVIDENCE_API_KEY=
STICKERBOMB_GEOFENCE_SALT=

# --- Verification strictness ---------------------------------------------------
# Relaxes what proof has to satisfy, for demonstrations. Widens the geofence to
# 500 m, drops the time-on-site requirement, stops requiring a location trail,
# and skips the timed challenge. It does NOT relax scanning the right poster,
# reusing a photo, one person playing both roles, or a placement submitted from
# the wrong side of the city, so a rejection is still demonstrable.
#
# Server-only on purpose: it must not be readable from the browser, and it is
# kept separate from NEXT_PUBLIC_DEMO_MODE so showing the demo controls does not
# silently weaken verification.
STICKERBOMB_LENIENT_VERIFICATION=false

# How long a self-verifying worker must be seen on site (ignored when lenient).
STICKERBOMB_MIN_DWELL_SECONDS=30

# Share of self-verified placements drawn for a second, human check.
STICKERBOMB_SPOT_CHECK_PERCENT=10

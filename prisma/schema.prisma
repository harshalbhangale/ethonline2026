generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  BRAND
  WORKER
  OPERATOR
}

enum CampaignStatus {
  DRAFT
  QUOTED
  FUNDED
  ASSETS_READY
  DEPLOYING
  VERIFYING
  LIVE
  EXPIRED
  REMOVING
  COMPLETE
  CANCELLED
  DISPUTED
}

enum CampaignWizardStep {
  BRIEF
  LOCATION
  PLACEMENTS
  CREATIVE
  REVIEW
}

enum LocationStrategy {
  AUTO_APPROVED
  MANUAL_SELECTION
}

/// The physical asset a campaign prints. Each tier carries a price multiplier
/// applied to per-placement fulfilment costs in the deterministic quote engine.
enum AssetType {
  QR_NORMAL
  QR_MAGIC
  QR_VERY_MAGIC
  NFC
}

enum LocationPermissionStatus {
  PENDING
  APPROVED
  REVOKED
}

enum CampaignLocationSource {
  BRAND
  SYSTEM
}

enum QuoteStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum QuoteLineItemKind {
  PRINTING
  INSTALLATION
  VERIFICATION
  CLEANUP_RESERVE
  PLATFORM_FEE
  CONTINGENCY
}

enum CampaignAssetStatus {
  PENDING
  GENERATING
  READY
  DISABLED
}

enum JobRole {
  INSTALLER
  VERIFIER
  CLEANUP
}

enum JobStatus {
  OPEN
  RESERVED
  ACCEPTED
  IN_PROGRESS
  PROOF_SUBMITTED
  ACCEPTED_PROOF
  REJECTED_PROOF
  PAID
  CANCELLED
  EXPIRED
}

enum PlacementStatus {
  AWAITING_INSTALL
  INSTALLING
  INSTALL_SUBMITTED
  AWAITING_VERIFIER
  VERIFYING
  READY_FOR_FINAL_VERIFICATION
  VERIFIED
  NEEDS_RECAPTURE
  REMOVING
  REMOVED
  CANCELLED
}

enum SelfieCheckStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
}

enum WorkerRiskStatus {
  CLEAR
  REVIEW
  BLOCKED
}

enum EvidenceStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ChainTransactionKind {
  TREASURY_TOPUP
  GAS_TOPUP
  USDC_APPROVE
  CAMPAIGN_FUND
  PLACEMENT_REGISTER
  WORKERS_ASSIGN
  PLACEMENT_VERIFIED
  PLACEMENT_REJECTED
  CLEANUP_RELEASE
  CAMPAIGN_REFUND
}

enum ChainTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum FundingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum VerificationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum VerificationMode {
  SELF
  INDEPENDENT
}

model User {
  id                   String               @id @default(cuid())
  privyUserId          String               @unique @map("privy_user_id") @db.VarChar(255)
  walletAddress        String?              @map("wallet_address") @db.VarChar(64)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          OrganizationMember[]
  createdOrganizations Organization[]       @relation("OrganizationCreator")
  campaignsCreated     Campaign[]           @relation("CampaignCreator")
  evidence             Evidence[]
  locationPings        LocationPing[]
  fundingRequested     FundingRequest[]     @relation("FundingRequester")
  fundingDecided       FundingRequest[]     @relation("FundingDecider")
  installedPlacements  Placement[]          @relation("PlacementInstaller")
  verifiedPlacements   Placement[]          @relation("PlacementVerifier")
  jobs                 Job[]                @relation("JobWorker")
  workerProfile        WorkerProfile?

  @@map("users")
}

model Organization {
  id                     String               @id @default(cuid())
  name                   String               @db.VarChar(120)
  slug                   String               @unique @db.VarChar(160)
  createdById            String               @map("created_by")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Privy server wallet that holds the organization's stablecoin treasury.
  treasuryWalletId       String?              @unique @map("treasury_wallet_id") @db.VarChar(64)
  treasuryAddress        String?              @map("treasury_address") @db.VarChar(64)
  /// Privy policy restricting the treasury to escrow funding on Sepolia.
  treasuryPolicyId       String?              @map("treasury_policy_id") @db.VarChar(64)
  /// The escrow the current policy allows. A new escrow deployment needs a
  /// new policy, or Privy would refuse to fund it.
  treasuryPolicyEscrow   String?              @map("treasury_policy_escrow") @db.VarChar(42)
  /// Funding above this amount (minor units) needs a second member's approval.
  approvalThresholdMinor BigInt?              @map("approval_threshold_minor")
  creator                User                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members                OrganizationMember[]
  campaigns              Campaign[]
  chainTransactions      ChainTransaction[]
  fundingRequests        FundingRequest[]

  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// A permissioned physical surface StickerBomb is allowed to use.
/// Exact points are assigned by the system, never chosen by the brand.
model Location {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique @db.VarChar(160)
  venueName             String                   @map("venue_name") @db.VarChar(160)
  countryCode           String                   @map("country_code") @db.VarChar(2)
  countryName           String                   @map("country_name") @db.VarChar(120)
  city                  String                   @db.VarChar(160)
  latitude              Float
  longitude             Float
  surfacePhotoUrl       String?                  @map("surface_photo_url") @db.Text
  placementInstructions String                   @map("placement_instructions") @db.Text
  permissionStatus      LocationPermissionStatus @default(PENDING) @map("permission_status")
  maxActiveCampaigns    Int                      @default(1) @map("max_active_campaigns")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  campaignLocations     CampaignLocation[]
  assets                CampaignAsset[]
  placements            Placement[]

  @@index([countryCode, city])
  @@index([permissionStatus])
  @@map("locations")
}

model Campaign {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  name           String             @db.VarChar(160)
  briefText      String             @map("brief_text") @db.Text
  status         CampaignStatus     @default(DRAFT)
  wizardStep     CampaignWizardStep @default(BRIEF) @map("wizard_step")
  currency       String             @default("USD") @db.VarChar(12)

  // Draft-completable fields. Nullable so the wizard can save after every step;
  // completeness is enforced at the DRAFT -> QUOTED transition, not by the database.
  placementCount   Int?      @map("placement_count")
  budgetLimitMinor BigInt?   @map("budget_limit_minor")
  destinationUrl   String?   @map("destination_url") @db.Text
  deadline         DateTime? @db.Timestamptz(3)

  // Structured geography. `areaLabel` is a generated human label and is never
  // read as source of truth.
  areaLabel        String?           @map("area_label") @db.VarChar(240)
  countryCode      String?           @map("country_code") @db.VarChar(2)
  countryName      String?           @map("country_name") @db.VarChar(120)
  city             String?           @db.VarChar(160)
  centerLatitude   Float?            @map("center_latitude")
  centerLongitude  Float?            @map("center_longitude")
  radiusMeters     Int?              @map("radius_meters")
  locationStrategy LocationStrategy? @map("location_strategy")

  /// The printed asset tier. Multiplies per-placement fulfilment costs.
  assetType AssetType @default(QR_NORMAL) @map("asset_type")

  artworkUrl  String? @map("artwork_url") @db.Text
  artworkHash String? @map("artwork_hash") @db.VarChar(128)
  /// How the poster QR is drawn (style, colour, legibility, crop). Validated
  /// and clamped to the asset tier by lib/assets/design.ts on every read.
  posterDesign Json? @map("poster_design")

  /// Set by the Phase 2 mocked funding action. Replaced by onchain escrow in Phase 4.
  fundedAt         DateTime? @map("funded_at") @db.Timestamptz(3)
  fundingReference String?   @map("funding_reference") @db.VarChar(120)

  /// keccak256 key of this campaign inside CampaignEscrow.
  escrowCampaignId  String? @unique @map("escrow_campaign_id") @db.VarChar(66)
  escrowAddress     String? @map("escrow_address") @db.VarChar(42)
  /// Amount deposited into escrow, in USD minor units.
  fundedAmountMinor BigInt? @map("funded_amount_minor")

  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator           User               @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  areas             CampaignArea[]
  locations         CampaignLocation[]
  quotes            CampaignQuote[]
  assets            CampaignAsset[]
  scanEvents        ScanEvent[]
  conversionEvents  ConversionEvent[]
  placements        Placement[]
  jobs              Job[]
  chainTransactions ChainTransaction[]
  fundingRequests   FundingRequest[]

  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([createdById])
  @@index([countryCode, city])
  @@map("campaigns")
}

/// One highlighted zone inside a campaign's city.
///
/// A campaign may target several neighbourhoods at once. The campaign's own
/// centre/radius columns mirror the first area so existing completeness checks
/// and worker dispatch keep a single canonical centre.
model CampaignArea {
  id           String   @id @default(cuid())
  campaignId   String   @map("campaign_id")
  label        String   @db.VarChar(160)
  latitude     Float
  longitude    Float
  radiusMeters Int      @map("radius_meters")
  sortOrder    Int      @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sortOrder])
  @@index([campaignId])
  @@map("campaign_areas")
}

model CampaignLocation {
  campaignId String                 @map("campaign_id")
  locationId String                 @map("location_id")
  source     CampaignLocationSource
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  campaign   Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location   Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([campaignId, locationId])
  @@index([locationId])
  @@map("campaign_locations")
}

model CampaignQuote {
  id         String                  @id @default(cuid())
  campaignId String                  @map("campaign_id")
  version    Int
  status     QuoteStatus             @default(DRAFT)
  currency   String                  @default("USD") @db.VarChar(12)
  totalMinor BigInt                  @map("total_minor")
  approvedAt DateTime?               @map("approved_at") @db.Timestamptz(3)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lineItems  CampaignQuoteLineItem[]

  @@unique([campaignId, version])
  @@index([campaignId, status])
  @@map("campaign_quotes")
}

model CampaignQuoteLineItem {
  id          String            @id @default(cuid())
  quoteId     String            @map("quote_id")
  kind        QuoteLineItemKind
  label       String            @db.VarChar(120)
  amountMinor BigInt            @map("amount_minor")
  sortOrder   Int               @map("sort_order")
  quote       CampaignQuote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, kind])
  @@index([quoteId])
  @@map("campaign_quote_line_items")
}

model CampaignAsset {
  id               String              @id @default(cuid())
  campaignId       String              @map("campaign_id")
  locationId       String?             @map("location_id")
  shortCode        String              @unique @map("short_code") @db.VarChar(32)
  sequence         Int
  qrPayload        String              @map("qr_payload") @db.Text
  destinationUrl   String              @map("destination_url") @db.Text
  artworkHash      String?             @map("artwork_hash") @db.VarChar(128)
  renderedAssetUrl String?             @map("rendered_asset_url") @db.Text
  version          Int                 @default(1)
  status           CampaignAssetStatus @default(PENDING)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  campaign         Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location         Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  scanEvents       ScanEvent[]
  conversionEvents ConversionEvent[]
  placement        Placement?

  @@unique([campaignId, sequence])
  @@index([campaignId])
  @@index([locationId])
  @@map("campaign_assets")
}

/// Privacy-safe attribution for a public QR scan.
/// Never stores public visitor identity and never triggers a worker payout.
model ScanEvent {
  id             String            @id @default(cuid())
  assetId        String            @map("asset_id")
  campaignId     String            @map("campaign_id")
  referrer       String?           @db.Text
  userAgentHash  String?           @map("user_agent_hash") @db.VarChar(64)
  sessionHash    String?           @map("session_hash") @db.VarChar(64)
  coarseRegion   String?           @map("coarse_region") @db.VarChar(120)
  isSuspectedBot Boolean           @default(false) @map("is_suspected_bot")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  asset          CampaignAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  campaign       Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversions    ConversionEvent[]

  @@index([campaignId, createdAt(sort: Desc)])
  @@index([assetId, createdAt(sort: Desc)])
  @@index([sessionHash])
  @@map("scan_events")
}

/// What happened after a scan, reported by the brand's own site.
///
/// Each row is tied to the scan that caused it, so a signup is attributable to
/// one physical poster. The name is the brand's own label, except "landing"
/// which the StickerBomb snippet fires on page load; that is the only way to
/// tell a scan apart from an actual arrival on the site.
model ConversionEvent {
  id          String        @id @default(cuid())
  scanEventId String        @map("scan_event_id")
  assetId     String        @map("asset_id")
  campaignId  String        @map("campaign_id")
  name        String        @db.VarChar(60)
  valueMinor  BigInt?       @map("value_minor")
  currency    String?       @db.VarChar(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  scanEvent   ScanEvent     @relation(fields: [scanEventId], references: [id], onDelete: Cascade)
  asset       CampaignAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// One row per scan per event name, so a refreshed page cannot inflate counts.
  @@unique([scanEventId, name])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([assetId, createdAt(sort: Desc)])
  @@map("conversion_events")
}

/// One physical asset at one approved location, from installation to removal.
///
/// Under INDEPENDENT verification the installer and verifier must be different
/// people, enforced by the job service and by a CHECK constraint in the
/// migration. Under SELF verification no separate verifier is assigned at all,
/// so `verifierUserId` stays null and that constraint is simply not engaged;
/// the escrow is given the installer's wallet for both roles instead.
model Placement {
  id                 String             @id @default(cuid())
  campaignId         String             @map("campaign_id")
  assetId            String             @unique @map("asset_id")
  locationId         String             @map("location_id")
  status             PlacementStatus    @default(AWAITING_INSTALL)
  installerUserId    String?            @map("installer_user_id")
  verifierUserId     String?            @map("verifier_user_id")
  /// Set in Phase 4 when the placement is registered with CampaignEscrow.
  onchainPlacementId String?            @map("onchain_placement_id") @db.VarChar(80)
  installedAt        DateTime?          @map("installed_at") @db.Timestamptz(3)
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  removedAt          DateTime?          @map("removed_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  campaign           Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset              CampaignAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  location           Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  installer          User?              @relation("PlacementInstaller", fields: [installerUserId], references: [id], onDelete: Restrict)
  verifier           User?              @relation("PlacementVerifier", fields: [verifierUserId], references: [id], onDelete: Restrict)
  /// SELF: the installer's own proof, judged by the confidential CRE check
  /// (location trail, poster code, photo). INDEPENDENT: a second worker
  /// checks, used for randomly sampled spot checks.
  verificationMode   VerificationMode   @default(SELF) @map("verification_mode")
  spotCheckRequired  Boolean            @default(false) @map("spot_check_required")
  jobs               Job[]
  evidence           Evidence[]
  chainTransactions  ChainTransaction[]
  verificationRuns   VerificationRun[]
  locationPings      LocationPing[]

  @@index([campaignId])
  @@index([locationId])
  @@index([status])
  @@map("placements")
}

/// Paid physical work on a placement. At most one job per role per placement;
/// a rejected proof is recaptured on the same job rather than opening another.
model Job {
  id            String         @id @default(cuid())
  placementId   String         @map("placement_id")
  campaignId    String         @map("campaign_id")
  role          JobRole
  status        JobStatus      @default(OPEN)
  rewardMinor   BigInt         @map("reward_minor")
  currency      String         @default("USD") @db.VarChar(12)
  workerUserId  String?        @map("worker_user_id")
  reservedUntil DateTime?      @map("reserved_until") @db.Timestamptz(3)
  acceptedAt    DateTime?      @map("accepted_at") @db.Timestamptz(3)
  startedAt     DateTime?      @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime?      @map("submitted_at") @db.Timestamptz(3)
  resolvedAt    DateTime?      @map("resolved_at") @db.Timestamptz(3)
  paidAt        DateTime?      @map("paid_at") @db.Timestamptz(3)
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  placement     Placement      @relation(fields: [placementId], references: [id], onDelete: Cascade)
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  worker        User?          @relation("JobWorker", fields: [workerUserId], references: [id], onDelete: Restrict)
  evidence      Evidence[]
  locationPings LocationPing[]

  @@unique([placementId, role])
  @@index([campaignId])
  @@index([status, role])
  @@index([workerUserId, status])
  @@map("jobs")
}

/// A person who can take paid physical work. Created by worker onboarding.
/// World Selfie Check (Phase 4) sets `selfieCheckStatus`; until then it is
/// recorded but not enforced.
model WorkerProfile {
  id                String            @id @default(cuid())
  userId            String            @unique @map("user_id")
  displayName       String?           @map("display_name") @db.VarChar(80)
  selfieCheckStatus SelfieCheckStatus @default(NOT_STARTED) @map("selfie_check_status")
  riskStatus        WorkerRiskStatus  @default(CLEAR) @map("risk_status")
  completedJobs     Int               @default(0) @map("completed_jobs")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

/// Proof captured at a placement. Exact coordinates and media fingerprints are
/// sensitive: they are read only by the confidential CRE workflow and are never
/// returned to brands or written onchain.
model Evidence {
  id                 String         @id @default(cuid())
  placementId        String         @map("placement_id")
  jobId              String         @map("job_id")
  role               JobRole
  workerUserId       String         @map("worker_user_id")
  scannedShortCode   String         @map("scanned_short_code") @db.VarChar(32)
  latitude           Float
  longitude          Float
  accuracyMeters     Float?         @map("accuracy_meters")
  capturedAt         DateTime       @map("captured_at") @db.Timestamptz(3)
  challengeSymbol    String         @map("challenge_symbol") @db.VarChar(16)
  challengeResponse  String         @map("challenge_response") @db.VarChar(16)
  challengeIssuedAt  DateTime       @map("challenge_issued_at") @db.Timestamptz(3)
  challengeExpiresAt DateTime       @map("challenge_expires_at") @db.Timestamptz(3)
  /// sha256 of the captured media, hex with 0x prefix.
  mediaHash          String         @map("media_hash") @db.VarChar(66)
  mediaPath          String?        @map("media_path") @db.Text
  status             EvidenceStatus @default(SUBMITTED)
  rejectionReason    String?        @map("rejection_reason") @db.VarChar(64)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  placement          Placement      @relation(fields: [placementId], references: [id], onDelete: Cascade)
  job                Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker             User           @relation(fields: [workerUserId], references: [id], onDelete: Restrict)

  @@index([placementId, role])
  @@index([mediaHash])
  @@map("evidence")
}

/// A transaction StickerBomb sent or observed on Sepolia. Balances are always
/// read from chain; this table is the human-readable history.
model ChainTransaction {
  id             String                 @id @default(cuid())
  organizationId String?                @map("organization_id")
  campaignId     String?                @map("campaign_id")
  placementId    String?                @map("placement_id")
  kind           ChainTransactionKind
  status         ChainTransactionStatus @default(PENDING)
  chainId        Int                    @map("chain_id")
  txHash         String                 @map("tx_hash") @db.VarChar(66)
  logIndex       Int                    @default(-1) @map("log_index")
  fromAddress    String?                @map("from_address") @db.VarChar(42)
  toAddress      String?                @map("to_address") @db.VarChar(42)
  /// Token base units (6 decimals) for stablecoin moves, wei for gas top-ups.
  amount         String?                @db.VarChar(80)
  /// True when the transaction was signed by a Privy wallet.
  viaPrivy       Boolean                @default(false) @map("via_privy")
  blockNumber    BigInt?                @map("block_number")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campaign       Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  placement      Placement?             @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@unique([txHash, logIndex, kind])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([campaignId])
  @@index([placementId])
  @@map("chain_transactions")
}

/// A campaign funding that exceeded the organization's approval threshold and
/// waits for a second member before the treasury moves money.
model FundingRequest {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  campaignId     String               @map("campaign_id")
  amountMinor    BigInt               @map("amount_minor")
  status         FundingRequestStatus @default(PENDING)
  requestedById  String               @map("requested_by")
  decidedById    String?              @map("decided_by")
  decidedAt      DateTime?            @map("decided_at") @db.Timestamptz(3)
  failureReason  String?              @map("failure_reason") @db.Text
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requestedBy    User                 @relation("FundingRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?                @relation("FundingDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([campaignId])
  @@map("funding_requests")
}

/// One run of the confidential placement-verification workflow.
model VerificationRun {
  id           String                @id @default(cuid())
  placementId  String                @map("placement_id")
  status       VerificationRunStatus @default(QUEUED)
  /// "cre-simulate" (started by the app through the CRE CLI) or
  /// "cre-external" (verdict from a deployed workflow or a manual CLI run).
  mode         String                @db.VarChar(24)
  approved     Boolean?
  reasons      String[]
  evidenceHash String?               @map("evidence_hash") @db.VarChar(66)
  txHash       String?               @map("tx_hash") @db.VarChar(66)
  log          String?               @db.Text
  startedAt    DateTime?             @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?             @map("finished_at") @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  placement    Placement             @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId, createdAt(sort: Desc)])
  @@map("verification_runs")
}

/// A worker's live position while holding a job, sent by the Worker PWA every
/// few seconds. The full trail is read only by the confidential CRE check;
/// brands see just the latest position of an active job.
model LocationPing {
  id             String    @id @default(cuid())
  placementId    String    @map("placement_id")
  jobId          String    @map("job_id")
  workerUserId   String    @map("worker_user_id")
  latitude       Float
  longitude      Float
  accuracyMeters Float?    @map("accuracy_meters")
  recordedAt     DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  placement      Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker         User      @relation(fields: [workerUserId], references: [id], onDelete: Cascade)

  @@index([jobId, recordedAt])
  @@index([placementId, recordedAt(sort: Desc)])
  @@map("location_pings")
}
